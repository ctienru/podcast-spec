{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmbeddingResponse",
  "oneOf": [
    {
      "title": "EmbeddingSuccessResponse",
      "type": "object",
      "required": [
        "object",
        "data",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "object": {
          "type": "string",
          "enum": [
            "list"
          ],
          "description": "Always 'list'."
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/EmbeddingObject"
          },
          "description": "One embedding object per input text. Sort by 'index' before use."
        },
        "model": {
          "type": "string",
          "description": "Model name echoed back from the request."
        }
      }
    },
    {
      "title": "EmbeddingErrorResponse",
      "type": "object",
      "required": [
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string",
          "description": "Human-readable error message."
        }
      }
    }
  ],
  "definitions": {
    "EmbeddingObject": {
      "type": "object",
      "required": [
        "object",
        "index",
        "embedding"
      ],
      "additionalProperties": false,
      "properties": {
        "object": {
          "type": "string",
          "enum": [
            "embedding"
          ],
          "description": "Always 'embedding'."
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based position corresponding to the input array. Use this to re-order results."
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "description": "Dense float vector. Length is 384 for paraphrase-multilingual-MiniLM-L12-v2."
        }
      }
    }
  }
}