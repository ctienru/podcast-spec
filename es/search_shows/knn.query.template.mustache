{
  "_source": {
    "includes": [
      "show_id",
      "title",
      "description",
      "subtitle",
      "publisher",
      "language",
      "categories",
      "explicit",
      "show_type",
      "website_url",
      "image_url",
      "episode_count",
      "external_ids",
      "external_urls"
    ]
  },

  "knn": {
    "field": "embedding",
    "query_vector": {{{query_vector}}},
    "k": {{size}},
    "num_candidates": {{num_candidates}}{{#languagesJson}},
    "filter": {
      "terms": {
        "language": {{{languagesJson}}}
      }
    }{{/languagesJson}}
  },

  "size": {{size}}
}
